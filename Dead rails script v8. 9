local function logTelemetry(msg, isErr)
    pcall(function()
        local t = os.date("%H:%M:%S")
        if isErr then
            StatusDisplay.Text = string.format("[%s] HATA: %s\nToplam Bond: %d", t, tostring(msg), SessionTelemetry.TotalCollectedBonds)
            StatusDisplay.TextColor3 = Color3.fromRGB(231, 76, 60)
        else
            StatusDisplay.Text = string.format("[%s] %s\nToplam Bond: %d | Hedef: %s\nDöngü: %d", t, msg, SessionTelemetry.TotalCollectedBonds, SessionTelemetry.CurrentBondTargetName, SessionTelemetry.ScanCyclesCompleted)
            StatusDisplay.TextColor3 = Color3.fromRGB(46, 204, 113)
        end
    end)
end

