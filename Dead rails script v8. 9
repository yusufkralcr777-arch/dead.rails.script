-- Farm Butonu
local FarmButton = createBtn("💰 Treasury Bond Farmını Başlat", Color3.fromRGB(211, 84, 0))
FarmButton.MouseButton1Click:Connect(function()
    SessionTelemetry.ActiveBondFarmStatus = not SessionTelemetry.ActiveBondFarmStatus
    if SessionTelemetry.ActiveBondFarmStatus then
        FarmButton.Text = "⏹️ Bond Farmını Durdur"
        FarmButton.BackgroundColor3 = Color3.fromRGB(231, 76, 60)
        logTelemetry("Treasury Bond Toplama Aktif!", false)
    else
        FarmButton.Text = "💰 Treasury Bond Farmını Başlat"
        FarmButton.BackgroundColor3 = Color3.fromRGB(211, 84, 0)
        logTelemetry("Durduruldu.", true)
    end
    
    task.spawn(function()
        while SessionTelemetry.ActiveBondFarmStatus do
            pcall(function()
                local char = LocalPlayer.Character
                if not char then return end
                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end
                
                SessionTelemetry.ScanCyclesCompleted = SessionTelemetry.ScanCyclesCompleted + 1
                local bestTarget = nil
                local minDist = 999999
                
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if not SessionTelemetry.ActiveBondFarmStatus then break end
                    pcall(function()
                        if obj and (obj:IsA("BasePart") or obj:IsA("Model")) then
                            local nameLower = obj.Name:lower()
                            
                            -- KESİN FİLTRE: Zırh, silah, altın, para ASLA HEDEF ALINMAZ
                            local ignored = nameLower:find("armor") or nameLower:find("chestplate") or nameLower:find("helmet") or 
                                            nameLower:find("gold") or nameLower:find("cash") or nameLower:find("money") or 
                                            nameLower:find("gun") or nameLower:find("rifle") or nameLower:find("ammo")
                            
                            if not ignored then
                                local isBond = false
                                for _, kw in ipairs(Configuration.TargetKeywords) do
                                    if nameLower:find(kw) then
                                        isBond = true
                                        break
                                    end
                                end
                                
                                if isBond then
                                    local pos = nil
                                    if obj:IsA("BasePart") then
                                        pos = obj.Position
                                    elseif obj:IsA("Model") then
                                        local p = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                                        if p then pos = p.Position end
                                    end
                                    
                                    if pos then
                                        local dist = (pos - hrp.Position).Magnitude
                                        if dist < minDist then
                                            minDist = dist
                                            bestTarget = obj
                                        end
                                    end
                                end
                            end
                        end
                    end)
                end
                
                if bestTarget and SessionTelemetry.ActiveBondFarmStatus then
                    SessionTelemetry.CurrentBondTargetName = bestTarget.Name
                    local targetPos = nil
                    if bestTarget:IsA("BasePart") then
                        targetPos = bestTarget.Position
                    elseif bestTarget:IsA("Model") then
                        local p = bestTarget.PrimaryPart or bestTarget:FindFirstChildWhichIsA("BasePart")
                        if p then targetPos = p.Position end
                    end
                    
                    if targetPos then
                        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 1.5, 0))
                        task.wait(0.02)
                        
                        pcall(function()
                            for _, prompt in pairs(bestTarget:GetDescendants()) do
                                if prompt:IsA("ProximityPrompt") then
                                    prompt.HoldDuration = 0
                                    prompt.MaxActivationDistance = 99999
                                    fireproximityprompt(prompt)
                                end
                            end
                        end)
                        
                        pcall(function()
                            for _, cd in pairs(bestTarget:GetDescendants()) do
                                if cd:IsA("ClickDetector") then
                                    fireclickdetector(cd)
                                end
                            end
                        end)
                        
                        pcall(function()
                            for _, sub in pairs(bestTarget:GetDescendants()) do
                                if sub:IsA("TouchTransmitter") then
                                    firetouchinterest(hrp, sub.Parent, 0)
                                    firetouchinterest(hrp, sub.Parent, 1)
                                end
                            end
                        end)
                        
                        SessionTelemetry.TotalCollectedBonds = SessionTelemetry.TotalCollectedBonds + 1
                        logTelemetry("Treasury Bond Başarıyla Toplandı!", false)
                        task.wait(0.05)
                    end
                else
                    SessionTelemetry.CurrentBondTargetName = "Bond Bekleniyor..."
                    task.wait(0.2)
                end
            end)
            task.wait(0.05)
        end
    end)
end)

