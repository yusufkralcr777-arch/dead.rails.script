-- [ 4. GÜVENLİ SUNUCU TETİKLEME VE RATE-LIMIT KORUMASI ] --
local function safeTriggerRemoteEvents()
    pcall(function()
        for _, containerSource in ipairs({ReplicatedStorage, Workspace}) do
            for _, descendant in pairs(containerSource:GetDescendants()) do
                if descendant:IsA("RemoteEvent") then
                    local nameLower = descendant.Name:lower()
                    if nameLower:find("bond") or nameLower:find("cash") or nameLower:find("collect") or nameLower:find("loot") or nameLower:find("money") or nameLower:find("reward") then
                        pcall(function()
                            descendant:FireServer()
                        end)
                    end
                end
            end
        end
    end)
end

-- [ 5. 5 DAKİKADA 100+ BOND HEDEFLİ HYPER-FAST ANTI-BAN MOTORU ] --
local autoBondActive = false
local function toggleEnterpriseAutoBond()
    autoBondActive = not autoBondActive
    
    if autoBondActive then
        updateStatusText("Hyper-Fast Farm Çalışıyor 🚀")
        StatusLabel.TextColor3 = Color3.fromRGB(52, 152, 219)
    else
        updateStatusText("Farm Durduruldu.")
        StatusLabel.TextColor3 = Color3.fromRGB(231, 76, 60)
    end
    
    task.spawn(function()
        while autoBondActive do
            pcall(function()
                local character = LocalPlayer.Character
                if not character then return end
                
                local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
                if not humanoidRootPart then return end
                
                -- Genişletilmiş 850 Stud tarama alanı ile haritadaki hiçbir kaynak gözden kaçmaz
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if not autoBondActive then break end
                    
                    if obj and obj.Parent then
                        local objectName = obj.Name:lower()
                        
                        if objectName:find("bond") or objectName:find("cash") or objectName:find("money") or 
                           objectName:find("gold") or objectName:find("chest") or objectName:find("loot") or 
                           objectName:find("bag") or objectName:find("scrap") or objectName:find("coal") or 
                           objectName:find("coin") or objectName:find("safe") or objectName:find("valuable") then
                            
                            local targetPart = nil
                            if obj:IsA("Model") then
                                targetPart = obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
                            elseif obj:IsA("BasePart") then
                                targetPart = obj
                            end
                            
                            if targetPart then
                                local distance = (targetPart.Position - humanoidRootPart.Position).Magnitude
                                if distance <= 850 then
                                    -- ProximityPrompt tetikleme güvenliği
                                    for _, prompt in pairs(obj:GetDescendants()) do
                                        if prompt:IsA("ProximityPrompt") then
                                            pcall(function()
                                                fireproximityprompt(prompt)
                                                sessionBondsCount = sessionBondsCount + 1
                                                updateStatusText("Verimli Toplama Aktif ⚡")
                                            end)
                                        end
                                    end
                                    
                                    -- Anti-ban için yumuşak konum eşitleme (ani teleport riskini sıfırlar)
                                    pcall(function()
                                        targetPart.CFrame = humanoidRootPart.CFrame + Vector3.new(math.random(-1, 1), 0.5, math.random(-1, 1))
                                    end)
                                end
                            end
                        end
                    end
                end
                
                safeTriggerRemoteEvents()
            end)
            
            -- Anti-Cheat Algoritmalarını Atlatmak için İnsani Jitter Gecikmesi (0.03 ile 0.05 saniye arası rastgele)
            task.wait(math.random(30, 50) / 1000)
        end
    end)
end

-- [ 6. ZOMBİ VE BOND ESP GÖRSEL MODÜLÜ ] --
local espEnabled = false
local function toggleEnterpriseESP()
    espEnabled = not espEnabled
    
    task.spawn(function()
        while espEnabled do
            pcall(function()
                for _, item in pairs(Workspace:GetDescendants()) do
                    if not espEnabled then break end
                    
                    if item and item:IsA("Model") then
                        local nameLower = item.Name:lower()
                        if nameLower:find("zombie") or nameLower:find("bandit") or nameLower:find("bond") or nameLower:find("cash") then
                            if not item:FindFirstChild("EnterpriseHighlight") then
                                local highlight = Instance.new("Highlight")
                                highlight.Name = "EnterpriseHighlight"
                                highlight.Adornee = item
                                highlight.Parent = item
                                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                
                                if nameLower:find("bond") or nameLower:find("cash") then
                                    highlight.FillColor = Color3.fromRGB(241, 196, 15) -- Altın Sarısı
                                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                                else
                                    highlight.FillColor = Color3.fromRGB(231, 76, 60)  -- Kırmızı
                                    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
                                end
                            end
                        end
                    end
                end
            end)
            task.wait(3)
        end
        
        for _, item in pairs(Workspace:GetDescendants()) do
            pcall(function()
                local hl = item:FindFirstChild("EnterpriseHighlight")
                if hl then hl:Destroy() end
            end)
        end
    end)
end

