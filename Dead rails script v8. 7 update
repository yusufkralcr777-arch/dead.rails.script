-- [ SECTION 9: ADVANCED LOGGING UTILITY ] --
local function logTelemetry(message, isError)
    pcall(function()
        local timestamp = os.date("%H:%M:%S")
        local uptime = os.time() - SessionTelemetry.StartTime
        if isError then
            SessionTelemetry.ErrorsEncountered = SessionTelemetry.ErrorsEncountered + 1
            StatusDisplay.Text = string.format("[%s] HATA: %s\nToplam Bond: %d | Hatalar: %d", timestamp, tostring(message), SessionTelemetry.TotalCollectedBonds, SessionTelemetry.ErrorsEncountered)
            StatusDisplay.TextColor3 = Configuration.Theme.Danger
        else
            StatusDisplay.Text = string.format("[%s] %s\nToplam Bond: %d | Hedef: %s\nDöngü: %d | Süre: %ds", timestamp, message, SessionTelemetry.TotalCollectedBonds, SessionTelemetry.CurrentBondTargetName, SessionTelemetry.ScanCyclesCompleted, uptime)
            StatusDisplay.TextColor3 = Configuration.Theme.Success
        end
    end)
end

