-- [ SECTION 11: CORE STRICT BOND-ONLY FARMING ENGINE ] --
local function executeStrictBondFarmCycle()
    pcall(function()
        local character = LocalPlayer.Character
        if not character then return end
        
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoidRootPart then return end
        
        SessionTelemetry.ScanCyclesCompleted = SessionTelemetry.ScanCyclesCompleted + 1
        local closestBondTarget = nil
        local shortestDistance = Configuration.MaxScanDistance
        
        -- Workspace içinde sadece Treasury Bond ve para nesnelerini arayan hassas filtre
        for _, descendant in pairs(Workspace:GetDescendants()) do
            if not SessionTelemetry.ActiveBondFarmStatus then break end
            
            pcall(function()
                if descendant and (descendant:IsA("BasePart") or descendant:IsA("Model")) then
                    local nameLower = descendant.Name:lower()
                    
                    -- Ekstra güvenlik: Adında silah veya zırh geçen hiçbir şeye asla bakma!
                    local isIgnored = nameLower:find("gun") or nameLower:find("rifle") or nameLower:find("pistol") or 
                                      nameLower:find("sword") or nameLower:find("armor") or nameLower:find("chestplate") or 
                                      nameLower:find("helmet") or nameLower:find("ammo") or nameLower:find("knife")
                    
                    if not isIgnored then
                        local isValidBond = false
                        for _, keyword in ipairs(Configuration.TargetKeywords) do
                            if nameLower:find(keyword) then
                                isValidBond = true
                                break
                            end
                        end
                        
                        if isValidBond then
                            local targetPos = nil
                            if descendant:IsA("BasePart") then
                                targetPos = descendant.Position
                            elseif descendant:IsA("Model") then
                                local primary = descendant.PrimaryPart or descendant:FindFirstChildWhichIsA("BasePart")
                                if primary then targetPos = primary.Position end
                            end
                            
                            if targetPos then
                                local distance = (targetPos - humanoidRootPart.Position).Magnitude
                                if distance < shortestDistance then
                                    shortestDistance = distance
                                    closestBondTarget = descendant
                                end
                            end
                        end
                    end
                end
            end)
        end
        
        -- Sadece onaylanmış Bond/Para hedefine ışınlanma ve toplama aşaması
        if closestBondTarget and SessionTelemetry.ActiveBondFarmStatus then
            SessionTelemetry.CurrentBondTargetName = closestBondTarget.Name
            local targetPosition = nil
            
            if closestBondTarget:IsA("BasePart") then
                targetPosition = closestBondTarget.Position
            elseif closestBondTarget:IsA("Model") then
                local primary = closestBondTarget.PrimaryPart or closestBondTarget:FindFirstChildWhichIsA("BasePart")
                if primary then targetPosition = primary.Position end
            end
            
            if targetPosition then
                -- Güvenli konuma ışınlanma
                humanoidRootPart.CFrame = CFrame.new(targetPosition + Vector3.new(0, 2.0, 0))
                task.wait(0.03)
                
                -- Proximity Prompt Tetikleyicisi
                pcall(function()
                    for _, prompt in pairs(closestBondTarget:GetDescendants()) do
                        if prompt:IsA("ProximityPrompt") then
                            prompt.HoldDuration = 0
                            prompt.MaxActivationDistance = 99999
                            fireproximityprompt(prompt)
                        end
                    end
                end)
                
                -- Touch Transmitter Tetikleyicisi
                pcall(function()
                    for _, sub in pairs(closestBondTarget:GetDescendants()) do
                        if sub:IsA("TouchTransmitter") then
                            firetouchinterest(humanoidRootPart, sub.Parent, 0)
                            firetouchinterest(humanoidRootPart, sub.Parent, 1)
                        end
                    end
                end)
                
                SessionTelemetry.TotalCollectedBonds = SessionTelemetry.TotalCollectedBonds + 1
                logTelemetry("Tahvil (Bond) Başarıyla Toplandı!", false)
                task.wait(Configuration.CollectionDelay)
            end
        else
            SessionTelemetry.CurrentBondTargetName = "Tahvil Aranıyor..."
            task.wait(0.3)
        end
    end)
end

