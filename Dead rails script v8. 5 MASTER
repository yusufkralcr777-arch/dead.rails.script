-- [ SECTION 9: ADVANCED LOGGING UTILITY ] --
local function logTelemetry(message, isError)
    pcall(function()
        local timestamp = os.date("%H:%M:%S")
        local uptime = os.time() - SessionTelemetry.StartTime
        if isError then
            SessionTelemetry.ErrorsEncountered = SessionTelemetry.ErrorsEncountered + 1
            StatusDisplay.Text = string.format("[%s] ERROR: %s\nTotal Collected: %d | Errors: %d", timestamp, tostring(message), SessionTelemetry.TotalCollectedItems, SessionTelemetry.ErrorsEncountered)
            StatusDisplay.TextColor3 = Configuration.Theme.Danger
        else
            StatusDisplay.Text = string.format("[%s] %s\nTotal Collected: %d | Target: %s\nCycles: %d | Uptime: %ds", timestamp, message, SessionTelemetry.TotalCollectedItems, SessionTelemetry.CurrentTargetName, SessionTelemetry.ScanCyclesCompleted, uptime)
            StatusDisplay.TextColor3 = Configuration.Theme.Success
        end
    end)
end

