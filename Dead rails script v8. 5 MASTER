-- [ SECTION 11: CORE FARMING & TELEPORT ENGINE (v8.5 MASTER) ] --
local function executeEnterpriseFarmCycle()
    pcall(function()
        local character = LocalPlayer.Character
        if not character then return end
        
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoidRootPart then return end
        
        SessionTelemetry.ScanCyclesCompleted = SessionTelemetry.ScanCyclesCompleted + 1
        local closestTarget = nil
        local shortestDistance = Configuration.MaxScanDistance
        
        -- Deep Workspace Descent Scanning for Target Keywords with Advanced Fallback
        for _, descendant in pairs(Workspace:GetDescendants()) do
            if not SessionTelemetry.ActiveFarmStatus then break end
            
            pcall(function()
                if descendant and (descendant:IsA("BasePart") or descendant:IsA("Model")) then
                    local nameLower = descendant.Name:lower()
                    local isValidTarget = false
                    
                    for _, keyword in ipairs(Configuration.TargetKeywords) do
                        if nameLower:find(keyword) then
                            isValidTarget = true
                            break
                        end
                    end
                    
                    if isValidTarget then
                        local targetPos = nil
                        if descendant:IsA("BasePart") then
                            targetPos = descendant.Position
                        elseif descendant:IsA("Model") then
                            local primary = descendant.PrimaryPart or descendant:FindFirstChildWhichIsA("BasePart")
                            if primary then targetPos = primary.Position end
                        end
                        
                        if targetPos then
                            local distance = (targetPos - humanoidRootPart.Position).Magnitude
                            if distance < shortestDistance then
                                shortestDistance = distance
                                closestTarget = descendant
                            end
                        end
                    end
                end
            end)
        end
        
        -- Execution phase on identified optimal target
        if closestTarget and SessionTelemetry.ActiveFarmStatus then
            SessionTelemetry.CurrentTargetName = closestTarget.Name
            local targetPosition = nil
            
            if closestTarget:IsA("BasePart") then
                targetPosition = closestTarget.Position
            elseif closestTarget:IsA("Model") then
                local primary = closestTarget.PrimaryPart or closestTarget:FindFirstChildWhichIsA("BasePart")
                if primary then targetPosition = primary.Position end
            end
            
            if targetPosition then
                -- Safe Teleportation with Mesh Preservation offset
                humanoidRootPart.CFrame = CFrame.new(targetPosition + Vector3.new(0, 2.5, 0))
                task.wait(0.04)
                
                -- Proximity Prompt Trigger Bypass
                pcall(function()
                    for _, prompt in pairs(closestTarget:GetDescendants()) do
                        if prompt:IsA("ProximityPrompt") then
                            prompt.HoldDuration = 0
                            prompt.MaxActivationDistance = 99999
                            fireproximityprompt(prompt)
                        end
                    end
                end)
                
                -- Touch Transmitter Trigger Bypass
                pcall(function()
                    for _, sub in pairs(closestTarget:GetDescendants()) do
                        if sub:IsA("TouchTransmitter") then
                            firetouchinterest(humanoidRootPart, sub.Parent, 0)
                            firetouchinterest(humanoidRootPart, sub.Parent, 1)
                        end
                    end
                end)
                
                SessionTelemetry.TotalCollectedItems = SessionTelemetry.TotalCollectedItems + 1
                logTelemetry("Target Harvested Successfully!", false)
                task.wait(Configuration.CollectionDelay)
            end
        else
            SessionTelemetry.CurrentTargetName = "Searching..."
            task.wait(0.4)
        end
    end)
end

