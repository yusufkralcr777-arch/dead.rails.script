-- [ BÖLÜM 6: YARDIMCI LOGLAMA VE GÜVENLİ FONKSİYONLAR ] --
local function logTelemetry(message, isError)
    pcall(function()
        local timestamp = os.date("%H:%M:%S")
        local uptime = os.time() - SessionTelemetry.StartTime
        if isError then
            SessionTelemetry.ErrorsEncountered = SessionTelemetry.ErrorsEncountered + 1
            StatusDisplay.Text = string.format("[%s] Durum: %s\nHata Sayısı: %d", timestamp, tostring(message), SessionTelemetry.ErrorsEncountered)
            StatusDisplay.TextColor3 = Configuration.Theme.Danger
        else
            StatusDisplay.Text = string.format("[%s] %s\nToplam Bond: %d | Süre: %ds", timestamp, message, SessionTelemetry.TotalCollectedBonds, uptime)
            StatusDisplay.TextColor3 = Configuration.Theme.Success
        end
    end)
end

-- [ BÖLÜM 7: GELİŞMİŞ SAFE TELEPORT VE PROXIMITY MOTORU ] --
local function executeBondCollectionCycle()
    pcall(function()
        local character = LocalPlayer.Character
        if not character then return end
        
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoidRootPart then return end
        
        for _, descendant in pairs(Workspace:GetDescendants()) do
            if not SessionTelemetry.ActiveStatus then break end
            
            if descendant:IsA("ProximityPrompt") then
                pcall(function()
                    local parentPart = descendant.Parent
                    local targetPos = nil
                    
                    if parentPart and parentPart:IsA("BasePart") then
                        targetPos = parentPart.Position
                    elseif parentPart and parentPart:IsA("Model") then
                        local primary = parentPart.PrimaryPart or parentPart:FindFirstChildWhichIsA("BasePart")
                        if primary then
                            targetPos = primary.Position
                        end
                    end
                    
                    if targetPos then
                        local distance = (targetPos - humanoidRootPart.Position).Magnitude
                        if distance <= Configuration.MaxScanDistance then
                            -- Karakter model dokusunu koruyan akıllı güvenli ışınlanma
                            humanoidRootPart.CFrame = CFrame.new(targetPos + Vector3.new(0, 2.5, 0))
                            task.wait(0.04)
                            
                            descendant.HoldDuration = 0
                            descendant.MaxActivationDistance = 99999
                            fireproximityprompt(descendant)
                            
                            SessionTelemetry.TotalCollectedBonds = SessionTelemetry.TotalCollectedBonds + 1
                            logTelemetry("Güvenli Işınlanma ile Toplandı!", false)
                            task.wait(Configuration.CollectionDelay)
                        end
                    end
                end)
            end
        end
    end)
end

