-- [ BÖLÜM 6: YARDIMCI LOGLAMA VE GÜVENLİ FONKSİYONLAR ] --
local function logTelemetry(message, isError)
    pcall(function()
        local timestamp = os.date("%H:%M:%S")
        if isError then
            SessionTelemetry.ErrorsEncountered = SessionTelemetry.ErrorsEncountered + 1
            StatusDisplay.Text = string.format("[%s] Durum: %s", timestamp, tostring(message))
            StatusDisplay.TextColor3 = Configuration.Theme.Danger
        else
            StatusDisplay.Text = string.format("[%s] %s\nToplam Bond: %d / 100+", timestamp, message, SessionTelemetry.TotalCollectedBonds)
            StatusDisplay.TextColor3 = Configuration.Theme.Success
        end
    end)
end

-- [ BÖLÜM 7: GÜVENLİ TARAMA VE BOND TOPLAMA MOTORU (FİNAL OPTİMİZASYON) ] --
local function executeBondCollectionCycle()
    pcall(function()
        local character = LocalPlayer.Character
        if not character then return end
        
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoidRootPart then return end
        
        local workspaceDescendants = Workspace:GetDescendants()
        for _, object in pairs(workspaceDescendants) do
            if not SessionTelemetry.ActiveStatus then break end
            
            if object and object.Name then
                local objectNameLower = object.Name:lower()
                if objectNameLower:find("bond") or objectNameLower:find("cash") or objectNameLower:find("money") or objectNameLower:find("coin") then
                    local targetPart = nil
                    
                    if object:IsA("Model") then
                        targetPart = object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart")
                    elseif object:IsA("BasePart") then
                        targetPart = object
                    end
                    
                    if targetPart then
                        local distance = (targetPart.Position - humanoidRootPart.Position).Magnitude
                        if distance <= Configuration.MaxScanDistance then
                            -- Güvenli ProximityPrompt tetikleme
                            for _, descendant in pairs(object:GetDescendants()) do
                                if descendant:IsA("ProximityPrompt") then
                                    pcall(function()
                                        fireproximityprompt(descendant)
                                        SessionTelemetry.TotalCollectedBonds = SessionTelemetry.TotalCollectedBonds + 1
                                    end)
                                end
                            end
                            
                            -- Fizikleri bozmadan sıfır gecikmeli yakınlaştırma
                            pcall(function()
                                if targetPart and targetPart.Parent and not targetPart.Anchored then
                                    targetPart.CFrame = humanoidRootPart.CFrame + Vector3.new(0, 0.2, 0)
                                end
                            end)
                        end
                    end
                end
            end
        end
    end)
end

-- [ BÖLÜM 8: KONTROL DÜĞMELERİNİN ÜRETİMİ ] --
local function createEnterpriseButton(caption, defaultBg, activeBg)
    local btn = Instance.new("TextButton")
    btn.BackgroundColor3 = defaultBg
    btn.Size = UDim2.new(0, 308, 0, 44)
    btn.Font = Enum.Font.GothamBold
    btn.Text = caption
    btn.TextColor3 = Configuration.Theme.TextPrimary
    btn.TextSize = 12
    btn.BorderSizePixel = 0
    
    local corner = Instance.new("UICorner", btn)
    corner.CornerRadius = UDim.new(0, 8)
    
    btn.Parent = Container
    return btn
end

-- Düğme 1: Bond Farm Kontrolü
local FarmButton = createEnterpriseButton("🚀 Saf Oto Bond Farmını Başlat", Color3.fromRGB(211, 84, 0), Configuration.Theme.Success)
FarmButton.MouseButton1Click:Connect(function()
    SessionTelemetry.ActiveStatus = not SessionTelemetry.ActiveStatus
    
    if SessionTelemetry.ActiveStatus then
        FarmButton.Text = "⏹️ Bond Farmını Durdur"
        FarmButton.BackgroundColor3 = Configuration.Theme.Danger
        logTelemetry("Saf Bond Toplama Aktif!", false)
    else
        FarmButton.Text = "🚀 Saf Oto Bond Farmını Başlat"
        FarmButton.BackgroundColor3 = Color3.fromRGB(211, 84, 0)
        logTelemetry("Farm Durduruldu.", true)
    end
    
    task.spawn(function()
        while SessionTelemetry.ActiveStatus do
            executeBondCollectionCycle()
            task.wait(Configuration.CollectionDelay)
        end
    end)
end)

-- Düğme 2: Bond ESP Modülü
local espActive = false
local EspButton = createEnterpriseButton("👁️ Bond ESP Modülü: KAPALI", Color3.fromRGB(142, 68, 173), Configuration.Theme.Success)
EspButton.MouseButton1Click:Connect(function()
    espActive = not espActive
    if espActive then
        EspButton.Text = "👁️ Bond ESP Modülü: AÇIK ✅"
        EspButton.BackgroundColor3 = Configuration.Theme.Success
    else
        EspButton.Text = "👁️ Bond ESP Modülü: KAPALI"
        EspButton.BackgroundColor3 = Color3.fromRGB(142, 68, 173)
    end
    
    task.spawn(function()
        while espActive do
            pcall(function()
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if not espActive then break end
                    if obj and obj:IsA("Model") and obj.Name:lower():find("bond") then
                        if not obj:FindFirstChild("EnterpriseBondHighlight") then
                            local hl = Instance.new("Highlight")
                            hl.Name = "EnterpriseBondHighlight"
                            hl.Adornee = obj
                            hl.Parent = obj
                            hl.FillColor = Configuration.Theme.Accent
                            hl.OutlineColor = Configuration.Theme.TextPrimary
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        end
                    end
                end
            end)
            task.wait(3)
        end
        
        for _, obj in pairs(Workspace:GetDescendants()) do
            pcall(function()
                local hl = obj:FindFirstChild("EnterpriseBondHighlight")
                if hl then hl:Destroy() end
            end)
        end
    end)
end)

-- Düğme 3: Karakter Hızlandırma Modülü
local speedActive = false
local SpeedButton = createEnterpriseButton("⚡ Karakter Hız Sınırı: KAPALI", Color3.fromRGB(41, 128, 185), Configuration.Theme.Success)
