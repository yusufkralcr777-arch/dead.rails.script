local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = nil

-- [ BÖLÜM 1: ÇEVRE VE GÜVENLİ BAĞLANTI DOĞRULAMA ] --
local function initializeEnvironment()
    local success, err = pcall(function()
        PlayerGui = LocalPlayer:WaitForChild("PlayerGui", 30)
    end)
    
    if not success or not PlayerGui then
        pcall(function()
            PlayerGui = CoreGui
        end)
    end
    
    if not PlayerGui then
        return false
    end
    return true
end

if not initializeEnvironment() then return end

-- [ BÖLÜM 2: BELLEK VE ESKİ ÇAKIŞMA TEMİZLİKÇİSİ ] --
local function purgeOldInstances()
    pcall(function()
        for _, child in pairs(PlayerGui:GetChildren()) do
            if child.Name == "DeadRails_Enterprise_Hub_v5" then
                child:Destroy()
            end
        end
    end)
end

purgeOldInstances()

