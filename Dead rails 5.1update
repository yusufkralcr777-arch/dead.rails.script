    end
end)

RunService.RenderStepped:Connect(function()
    if speedActive then
        pcall(function()
            local char = LocalPlayer.Character
            if char then
                local hum = char:FindFirstChild("Humanoid")
                if hum then
                    hum.WalkSpeed = 26
                end
            end
        end)
    end
end)

-- Düğme 4: Aydınlatma Modülü (Fullbright)
local fullbrightActive = false
local FullbrightButton = createEnterpriseButton("☀️ Fullbright Aydınlatma: KAPALI", Color3.fromRGB(52, 73, 94), Configuration.Theme.Success)
FullbrightButton.MouseButton1Click:Connect(function()
    fullbrightActive = not fullbrightActive
    if fullbrightActive then
        FullbrightButton.Text = "☀️ Fullbright Aydınlatma: AÇIK ✅"
        FullbrightButton.BackgroundColor3 = Configuration.Theme.Success
    else
        FullbrightButton.Text = "☀️ Fullbright Aydınlatma: KAPALI"
        FullbrightButton.BackgroundColor3 = Color3.fromRGB(52, 73, 94)
    end
    
    task.spawn(function()
        while fullbrightActive do
            pcall(function()
                Lighting.Brightness = 2
                Lighting.ClockTime = 14
                Lighting.GlobalShadows = false
                Lighting.FogEnd = 100000
            end)
            task.wait(1)
        end
        pcall(function()
            Lighting.GlobalShadows = true
            Lighting.Brightness = 1
        end)
    end)
end)

