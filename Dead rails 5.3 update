-- [ BÖLÜM 6: YARDIMCI LOGLAMA VE GÜVENLİ FONKSİYONLAR ] --
local function logTelemetry(message, isError)
    pcall(function()
        local timestamp = os.date("%H:%M:%S")
        if isError then
            SessionTelemetry.ErrorsEncountered = SessionTelemetry.ErrorsEncountered + 1
            StatusDisplay.Text = string.format("[%s] Durum: %s", timestamp, tostring(message))
            StatusDisplay.TextColor3 = Configuration.Theme.Danger
        else
            StatusDisplay.Text = string.format("[%s] %s\nToplam Bond: %d", timestamp, message, SessionTelemetry.TotalCollectedBonds)
            StatusDisplay.TextColor3 = Configuration.Theme.Success
        end
    end)
end

-- [ BÖLÜM 7: KESİN ÇÖZÜMLÜ PROXIMITY VE TREASUREBOND MOTORU ] --
local function executeBondCollectionCycle()
    pcall(function()
        local character = LocalPlayer.Character
        if not character then return end
        
        local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
        if not humanoidRootPart then return end
        
        for _, object in pairs(Workspace:GetDescendants()) do
            if not SessionTelemetry.ActiveStatus then break end
            
            if object and object.Name then
                local nameLower = object.Name:lower()
                if nameLower:find("bond") or nameLower:find("treasure") or nameLower:find("cash") or nameLower:find("coin") then
                    local targetPart = nil
                    
                    if object:IsA("Model") then
                        targetPart = object.PrimaryPart or object:FindFirstChildWhichIsA("BasePart")
                    elseif object:IsA("BasePart") then
                        targetPart = object
                    end
                    
                    if targetPart then
                        local distance = (targetPart.Position - humanoidRootPart.Position).Magnitude
                        if distance <= Configuration.MaxScanDistance then
                            -- PROXIMITY PROMPT BYPASS: HoldDuration sıfırlanır ve menzil sınırsız yapılır
                            for _, descendant in pairs(object:GetDescendants()) do
                                if descendant:IsA("ProximityPrompt") then
                                    pcall(function()
                                        descendant.HoldDuration = 0
                                        descendant.MaxActivationDistance = 99999
                                        fireproximityprompt(descendant)
                                        SessionTelemetry.TotalCollectedBonds = SessionTelemetry.TotalCollectedBonds + 1
                                    end)
                                end
                            end
                            
                            -- Nesneyi oyuncunun konumuna taşıyarak fiziksel toplama garantisi
                            pcall(function()
                                if targetPart and targetPart.Parent and not targetPart.Anchored then
                                    targetPart.CFrame = humanoidRootPart.CFrame + Vector3.new(0, 0.5, 0)
                                end
                            end)
                        end
                    end
                end
            end
        end
    end)
end

