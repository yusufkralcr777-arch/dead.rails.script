local function CreateESPForTarget(obj, text)
    if not Config.ESPEnabled or not obj then return end
    local targetPart = obj:IsA("BasePart") and obj or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")))
    if not targetPart then return end
    
    local hl = Instance.new("Highlight")
    hl.Adornee = obj
    hl.FillColor = Config.ESPColor
    hl.FillTransparency = Config.ESPFillTransparency
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.Parent = ESPContainer
    
    local bb = Instance.new("BillboardGui")
    bb.Adornee = targetPart
    bb.Size = UDim2.new(0, 150, 0, 40)
    bb.StudsOffset = Vector3.new(0, 3, 0)
    bb.AlwaysOnTop = true
    
    local txt = Instance.new("TextLabel")
    txt.Parent = bb
    txt.Size = UDim2.new(1, 0, 1, 0)
    txt.BackgroundTransparency = 1
    txt.Text = string.format("📜 %s", text or obj.Name)
    txt.TextColor3 = Config.ESPColor
    txt.Font = Enum.Font.GothamBold
    txt.TextSize = 12
    bb.Parent = ESPContainer
end

local function IsValidTarget(obj)
    if not obj then return false end
    local name = obj.Name:lower()
    
    -- Blacklist Kontrolü
    for _, black in ipairs(Config.BlacklistKeywords) do
        if name:find(black) then return false end
    end
    
    -- Whitelist Kontrolü (İsimden)
    for _, white in ipairs(Config.WhitelistKeywords) do
        if name:find(white) then return true end
    end
    
    -- ProximityPrompt Kontrolü
    for _, descendant in pairs(obj:GetDescendants()) do
        if descendant:IsA("ProximityPrompt") then
            local actionText = (descendant.ActionText or ""):lower()
            local objectText = (descendant.ObjectText or ""):lower()
            
            local isBlacklisted = false
            for _, black in ipairs(Config.BlacklistKeywords) do
                if actionText:find(black) or objectText:find(black) then
                    isBlacklisted = true
                    break
                end
            end
            
            if not isBlacklisted then
                for _, white in ipairs(Config.WhitelistKeywords) do
                    if actionText:find(white) or objectText:find(white) then
                        return true
                    end
                end
            end
        end
    end
    
    return false
end

local function FindBestTarget()
    local _, hrp = GetCharacter()
    if not hrp then return nil end
    
    local closestTarget = nil
    local shortestDistance = 999999
    
    ClearESP()
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if not Config.FarmEnabled then break end
        
        if (obj:IsA("BasePart") or obj:IsA("Model")) and IsValidTarget(obj) then
            local pos = obj:IsA("BasePart") and obj.Position or (obj:IsA("Model") and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")) and (obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")).Position)
            
            if pos then
                local dist = (pos - hrp.Position).Magnitude
                CreateESPForTarget(obj, string.format("%s (%dm)", obj.Name, math.floor(dist)))
                
                if dist < shortestDistance then
                    shortestDistance = dist
                    closestTarget = {Object = obj, Position = pos, Distance = dist}
                end
            end
        end
    end
    
    return closestTarget
end

local function SafeBypassTween(hrp, targetPos)
    if not hrp or not targetPos then return false end
    ResetVelocity(hrp)
    
    local destinationCFrame = CFrame.new(targetPos + Vector3.new(0, Config.TargetHeightOffset, 0))
    local distance = (hrp.Position - destinationCFrame.Position).Magnitude
    local tweenTime = distance / Config.TweenSpeed
    if tweenTime < 0.05 then tweenTime = 0.05 end
    
    local tweenInfo = TweenInfo.new(tweenTime, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(hrp, tweenInfo, {CFrame = destinationCFrame})
    
    local completed = false
    local connection
    connection = tween.Completed:Connect(function()
        completed = true
        if connection then connection:Disconnect() end
    end)
    
    tween:Play()
    
    local timeout = 0
    while not completed and Config.FarmEnabled do
        ResetVelocity(hrp)
        task.wait(0.02)
        timeout = timeout + 0.02
        if timeout > tweenTime + 2 then
            tween:Cancel()
            break
        end
    end
    
    ResetVelocity(hrp)
    return true
end

local function InteractWithTarget(targetObj)
    if not targetObj then return false end
    local _, hrp = GetCharacter()
    local interacted = false
    
    for _, prompt in pairs(targetObj:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            pcall(function()
                prompt.HoldDuration = 0
                prompt.MaxActivationDistance = 99999
                fireproximityprompt(prompt)
                interacted = true
            end)
        end
    end
    
    for _, cd in pairs(targetObj:GetDescendants()) do
        if cd:IsA("ClickDetector") then
            pcall(function()
                fireclickdetector(cd)
                interacted = true
            end)
        end
    end
    
    if hrp then
        for _, touch in pairs(targetObj:GetDescendants()) do
            if touch:IsA("TouchTransmitter") then
                pcall(function()
                    firetouchinterest(hrp, touch.Parent, 0)
                    firetouchinterest(hrp, touch.Parent, 1)
                    interacted = true
                end)
            end
        end
    end
    
    return interacted
end

