local function StartFarmLoop()
    task.spawn(function()
        AddLog("Tahvil Toplama Döngüsü Başlatıldı.")
        
        while Config.FarmEnabled do
            local _, hrp = GetCharacter()
            
            if hrp then
                StatusLabel.Text = string.format("Durum: Harita Taranıyor (Banka/Kale)...\nHedef: Aranıyor...\nToplanan: %d", State.TotalCollected)
                
                local bestTarget = FindBestTarget()
                
                if bestTarget and Config.FarmEnabled then
                    State.CurrentTarget = bestTarget.Object
                    local targetName = bestTarget.Object.Name
                    
                    AddLog("Hedef Bulundu: " .. targetName .. " (" .. math.floor(bestTarget.Distance) .. "m)")
                    StatusLabel.Text = string.format("Durum: Hedefe Uçuluyor 🚀\nHedef: %s\nToplanan: %d", targetName, State.TotalCollected)
                    
                    local success = SafeBypassTween(hrp, bestTarget.Position)
                    
                    if success and Config.FarmEnabled then
                        StatusLabel.Text = string.format("Durum: Eşya Toplanıyor 🖐️\nHedef: %s\nToplanan: %d", targetName, State.TotalCollected)
                        task.wait(Config.InteractionDelay)
                        
                        local collected = InteractWithTarget(bestTarget.Object)
                        
                        if collected then
                            State.TotalCollected = State.TotalCollected + 1
                            AddLog("Başarıyla Toplandı: " .. targetName)
                            StatusLabel.Text = string.format("Durum: Toplandı! ✅\nSon Eşya: %s\nToplanan: %d", targetName, State.TotalCollected)
                        else
                            AddLog("Etkileşim Denendi: " .. targetName)
                        end
                        
                        task.wait(0.2)
                    end
                else
                    task.wait(Config.ScanInterval)
                end
            else
                StatusLabel.Text = "Durum: Karakter Bekleniyor..."
                task.wait(1)
            end
            
            UpdateLogUI()
            task.wait(0.1)
        end
        
        ClearESP()
        AddLog("Tahvil Farm'ı Durduruldu.")
        StatusLabel.Text = string.format("Durum: Durduruldu\nHedef: Yok\nToplanan: %d", State.TotalCollected)
        UpdateLogUI()
    end)
end

